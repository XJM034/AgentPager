      "events": [
        "SessionStart",
        "UserPromptSubmit",
        "PreToolUse",
        "PermissionRequest",
        "PostToolUse",
        "Stop"
      ],
      "result": "The hook failed after the configured timeout and ZCode fell back to its in-session permission card. The user allowed the tool there."
    },
    {
      "name": "tool-failure",
      "sessionRef": "session-failure",
      "toolRef": "tool-failure",
      "toolClass": "Read",
      "events": [
