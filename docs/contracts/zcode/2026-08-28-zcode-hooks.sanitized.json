  "observations": {
    "sessionIdentity": "session_id and sessionId matched throughout each captured session.",
    "toolIdentity": "tool_use_id remained stable across PreToolUse, PermissionRequest and the matching post-tool event.",
    "permissionStdout": {
      "PreToolUse": "hookSpecificOutput.permissionDecision=ask requested permission handling.",
      "PermissionRequestAllow": "hookSpecificOutput.decision.behavior=allow allowed execution.",
      "PermissionRequestDeny": "hookSpecificOutput.decision.behavior=deny blocked execution."
    },
    "nonzeroBashExit": "A Bash command with a nonzero exit code still emitted PostToolUse in this capture; it is not sufficient to infer PostToolUseFailure from process exit status.",
    "stopSemantics": "Stop had stop_hook_active=false and contained an assistant-message field. It marks the end of a model turn, not a proven terminal session state.",
    "headlessBoundary": "The embedded CLI had no permission client for an ask decision, so the complete PermissionRequest flow was validated in ZCode desktop."
  },
  "unknowns": [
    "No SessionEnd event was observed, so normal completion and interruption cannot be classified from Stop alone.",
    "No guarantee was established that future ZCode versions will preserve both snake_case and camelCase aliases.",
    "Permission timeout fallback was observed only in ZCode desktop 3.10.1 (6272)."
