<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <StartupObject>AgentPager.Bridge.Program</StartupObject>
    <AssemblyName>AgentPagerBridge</AssemblyName>
    <RootNamespace>AgentPager.Bridge</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AgentPager.Core\AgentPager.Core.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="QRCoder" />
    <Resource Include="..\..\..\assets\brand\agentpager-icon.png" Link="Assets\agentpager-icon.png" />
    <Resource Include="..\..\..\assets\fonts\fusion_pixel_12px_zh_hans.ttf" Link="Assets\fusion_pixel_12px_zh_hans.ttf" />
  </ItemGroup>
</Project>
